{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "packageRules": [
    {
      "description": "Preserve Rust 1.88 as the deliberate MSRV floor",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "rust-version"
      ],
      "matchPackageNames": [
        "rust"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yml"
      ],
      "matchCurrentValue": "/^1\\.88\\.0$/",
      "enabled": false
    },
    {
      "description": "Preserve Julia 1.12.6 as the deliberate compat-floor CI job",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "JuliaLang/julia"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yml"
      ],
      "matchCurrentValue": "/^1\\.12\\.6$/",
      "enabled": false
    },
    {
      "description": "Defer TypeScript major upgrades for one year",
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "365 days"
    }
  ]
}
