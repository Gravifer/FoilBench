{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"]
  },
  "references": [
    {"path": "./tsconfig.core.json"},
    {"path": "./tsconfig.browser.json"},
    {"path": "./tsconfig.node.json"}
  ],
  "include": [
    "tests/**/*.ts",
    "vite.config.ts",
    "vite.web.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.dist.config.ts",
    "playwright.web.config.ts"
  ]
}
