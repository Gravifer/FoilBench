{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false
  },
  "include": [
    "src/core/**/*.ts",
    "src/solvers/**/*.ts",
    "src/benchmark/types.ts",
    "src/benchmark/runner.ts",
    "src/benchmark/startupGate.ts",
    "src/benchmark/previewGate.ts",
    "src/benchmark/warmSwitchGate.ts",
    "src/benchmark/scheduledGate.ts",
    "src/experiments/chaoticWake.ts",
    "src/experiments/dragCalibration.ts",
    "src/cli.ts"
  ]
}
