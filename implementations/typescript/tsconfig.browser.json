{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist-types/browser",
    "rootDir": "src",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client"]
  },
  "references": [{"path": "./tsconfig.core.json"}],
  "include": [
    "src/viewer/main.ts",
    "src/viewer/sceneController.ts",
    "src/viewer/workerClient.ts",
    "src/worker/**/*.ts",
    "src/wasm/**/*.ts",
    "src/benchmark/browserEntry.ts",
    "src/benchmark/benchmarkWorker.ts"
  ]
}
