#!/usr/bin/env julia

using FoilBenchJulia
using JSON3

const _VIEW_REQUESTED = !isempty(ARGS) && first(ARGS) == "view"
if _VIEW_REQUESTED
    include(joinpath(@__DIR__, "..", "src", "viewer", "glmakie_app.jl"))
end

function usage()
    println("Usage:")
    println("  foilbench-jl view SCENARIO [--solver SOLVER_ID]")
    println("  foilbench-jl bench MATRIX [--output DIRECTORY]")
    println("  foilbench-jl compare RESULTS_DIRECTORY [--require-complete]")
    println("  foilbench-jl describe [--json]")
end

function main(arguments::Vector{String})
    isempty(arguments) && (usage(); return 2)
    first(arguments) in ("-h", "--help") && (usage(); return 0)
    command = first(arguments)
    if command == "describe"
        description = describe_implementation()
        if length(arguments) == 2 && arguments[2] == "--json"
            JSON3.pretty(stdout, description)
            println()
        elseif length(arguments) == 1
            println("FoilBench Julia")
            for entry in description["solvers"]
                println("  ", rpad(entry["id"], 18), entry["display_name"], " [", entry["acceleration"], "]")
            end
            println("  thin periodic 3D: declared by schema, unsupported in Phase 2A")
        else
            println(stderr, "unexpected describe arguments")
            return 2
        end
        return 0
    elseif command == "compare"
        length(arguments) in (2, 3) || (println(stderr, "compare requires a results directory"); return 2)
        require_complete = length(arguments) == 3
        require_complete && arguments[3] != "--require-complete" &&
            (println(stderr, "unexpected compare argument"); return 2)
        println(format_benchmark_comparison(arguments[2]; require_complete))
        return 0
    elseif command == "bench"
        length(arguments) in (2, 4) || (println(stderr, "unexpected bench arguments"); return 2)
        output = nothing
        if length(arguments) == 4
            arguments[3] == "--output" || (println(stderr, "expected --output"); return 2)
            output = arguments[4]
        end
        println(run_benchmark_matrix(arguments[2], output))
        return 0
    elseif command != "view"
        println(stderr, "unknown command: $command")
        usage()
        return 2
    end
    length(arguments) >= 2 || begin
        println(stderr, "view requires a scenario path")
        usage()
        return 2
    end
    scenario_path = arguments[2]
    solver_id = "stable-fluids"
    if length(arguments) > 2
        length(arguments) == 4 && arguments[3] == "--solver" || begin
            println(stderr, "unexpected view arguments")
            usage()
            return 2
        end
        solver_id = arguments[4]
    end
    FoilBenchGLMakie.run_viewer(scenario_path; solver_id)
    return 0
end

exit(main(ARGS))
