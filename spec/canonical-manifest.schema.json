{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foilbench.local/spec/canonical-manifest.schema.json",
  "title": "FoilBench canonical state manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dimension", "bounds", "resolution", "periodic_axes",
    "time", "precision", "angle_degrees", "angular_velocity_degrees",
    "source_language", "source_solver", "velocity", "density"
  ],
  "$defs": {
    "bound": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false
    },
    "arrayMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "axes", "order"],
      "properties": {
        "file": {"type": "string"},
        "axes": {"type": "array", "items": {"type": "string"}},
        "order": {"enum": ["C", "F"]}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "dimension": {"enum": [2, 3]},
    "bounds": {"type": "array", "items": {"$ref": "#/$defs/bound"}},
    "resolution": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "periodic_axes": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["x", "y", "z"]}
    },
    "time": {"type": "number", "minimum": 0},
    "precision": {"enum": ["float32", "float64"]},
    "angle_degrees": {"type": "number"},
    "angular_velocity_degrees": {"type": "number"},
    "source_language": {"type": "string", "minLength": 1},
    "source_solver": {"type": "string", "minLength": 1},
    "velocity": {
      "allOf": [
        {"$ref": "#/$defs/arrayMetadata"},
        {"properties": {
          "file": {"const": "velocity.npy"},
          "axes": {"const": ["z", "y", "x", "component"]}
        }}
      ]
    },
    "density": {
      "oneOf": [
        {"type": "null"},
        {"allOf": [
          {"$ref": "#/$defs/arrayMetadata"},
          {"properties": {
            "file": {"const": "density.npy"},
            "axes": {"const": ["z", "y", "x"]}
          }}
        ]}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"dimension": {"const": 2}}},
      "then": {
        "properties": {
          "bounds": {"minItems": 2, "maxItems": 2},
          "resolution": {"minItems": 2, "maxItems": 2},
          "periodic_axes": {"items": {"enum": ["x", "y"]}}
        }
      },
      "else": {
        "properties": {
          "bounds": {"minItems": 3, "maxItems": 3},
          "resolution": {"minItems": 3, "maxItems": 3}
        }
      }
    }
  ]
}
