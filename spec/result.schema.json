{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foilbench.local/spec/result.schema.json",
  "title": "FoilBench benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_matrix_id",
    "scenario_id",
    "language",
    "solver",
    "git_commit",
    "machine",
    "precision",
    "resolution",
    "bounds",
    "periodic_axes",
    "reynolds",
    "freestream",
    "foil",
    "control_history",
    "requested_duration",
    "simulated_duration",
    "output_dt",
    "seed",
    "initialization_seconds",
    "cold_step_seconds",
    "step_seconds",
    "median_step_seconds",
    "p95_step_seconds",
    "simulated_seconds_per_wall_second",
    "cell_updates_per_second",
    "particle_updates_per_second",
    "peak_rss_bytes",
    "substeps",
    "diagnostics",
    "success",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_matrix_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string"},
    "language": {"type": "string"},
    "solver": {"type": "string"},
    "git_commit": {"type": "string"},
    "machine": {"type": "object"},
    "precision": {"enum": ["float32", "float64"]},
    "resolution": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"type": "integer", "minimum": 4}
    },
    "seed": {"type": "integer"},
    "initialization_seconds": {"type": "number", "minimum": 0},
    "cold_step_seconds": {"type": "number", "minimum": 0},
    "step_seconds": {"type": "array", "items": {"type": "number", "minimum": 0}},
    "median_step_seconds": {"type": "number", "minimum": 0},
    "p95_step_seconds": {"type": "number", "minimum": 0},
    "simulated_seconds_per_wall_second": {"type": "number", "minimum": 0},
    "cell_updates_per_second": {"type": "number", "minimum": 0},
    "particle_updates_per_second": {"type": "number", "minimum": 0},
    "peak_rss_bytes": {
      "anyOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "bounds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [{"type": "number"}, {"type": "number"}],
        "items": false
      }
    },
    "periodic_axes": {"type": "array", "uniqueItems": true, "items": {"enum": ["x", "y", "z"]}},
    "reynolds": {"type": "number", "exclusiveMinimum": 0},
    "freestream": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number"}},
    "foil": {
      "type": "object",
      "additionalProperties": false,
      "required": ["naca", "chord", "pivot"],
      "properties": {
        "naca": {"type": "string", "pattern": "^[0-9]{4}$"},
        "chord": {"type": "number", "exclusiveMinimum": 0},
        "pivot": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number"}}
      }
    },
    "control_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time", "angle_degrees"],
        "properties": {"time": {"type": "number", "minimum": 0}, "angle_degrees": {"type": "number"}}
      }
    },
    "requested_duration": {"type": "number", "exclusiveMinimum": 0},
    "simulated_duration": {"type": "number", "minimum": 0},
    "output_dt": {"type": "number", "exclusiveMinimum": 0},
    "memory_measurement": {
      "enum": ["rss", "browser-estimate", "unavailable"]
    },
    "runtime_startup_seconds": {
      "anyOf": [
        {"type": "number", "minimum": 0},
        {"type": "null"}
      ]
    },
    "worker_startup_seconds": {
      "anyOf": [
        {"type": "number", "minimum": 0},
        {"type": "null"}
      ]
    },
    "substeps": {"type": "integer", "minimum": 0},
    "diagnostics": {"type": "object"},
    "success": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
