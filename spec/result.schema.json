{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foilbench.local/spec/result.schema.json",
  "title": "FoilBench benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "language",
    "solver",
    "git_commit",
    "machine",
    "precision",
    "resolution",
    "seed",
    "initialization_seconds",
    "cold_step_seconds",
    "step_seconds",
    "median_step_seconds",
    "p95_step_seconds",
    "simulated_seconds_per_wall_second",
    "cell_updates_per_second",
    "particle_updates_per_second",
    "peak_rss_bytes",
    "substeps",
    "diagnostics",
    "success",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "scenario_id": {"type": "string"},
    "language": {"type": "string"},
    "solver": {"type": "string"},
    "git_commit": {"type": "string"},
    "machine": {"type": "object"},
    "precision": {"enum": ["float32", "float64"]},
    "resolution": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"type": "integer", "minimum": 4}
    },
    "seed": {"type": "integer"},
    "initialization_seconds": {"type": "number", "minimum": 0},
    "cold_step_seconds": {"type": "number", "minimum": 0},
    "step_seconds": {"type": "array", "items": {"type": "number", "minimum": 0}},
    "median_step_seconds": {"type": "number", "minimum": 0},
    "p95_step_seconds": {"type": "number", "minimum": 0},
    "simulated_seconds_per_wall_second": {"type": "number", "minimum": 0},
    "cell_updates_per_second": {"type": "number", "minimum": 0},
    "particle_updates_per_second": {"type": "number", "minimum": 0},
    "peak_rss_bytes": {"type": "integer", "minimum": 0},
    "substeps": {"type": "integer", "minimum": 0},
    "diagnostics": {"type": "object"},
    "success": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
