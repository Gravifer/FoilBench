{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foilbench.local/spec/result.schema.json",
  "title": "FoilBench benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_revision",
    "benchmark_matrix_id",
    "scenario_id",
    "language",
    "solver",
    "git_commit",
    "machine",
    "precision",
    "resolution",
    "bounds",
    "periodic_axes",
    "reynolds",
    "freestream",
    "foil",
    "control_history",
    "requested_duration",
    "simulated_duration",
    "output_dt",
    "seed",
    "initialization_seconds",
    "cold_step_seconds",
    "step_seconds",
    "median_step_seconds",
    "p95_step_seconds",
    "simulated_seconds_per_wall_second",
    "cell_updates_per_second",
    "particle_updates_per_second",
    "peak_rss_bytes",
    "memory_measurement",
    "runtime_startup_seconds",
    "worker_startup_seconds",
    "substeps",
    "final_state_revision",
    "diagnostic_state_revision",
    "last_step",
    "diagnostics",
    "success",
    "failure",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "foilbench-phase2-v1"},
    "contract_revision": {"const": 2},
    "benchmark_matrix_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string"},
    "language": {"type": "string"},
    "solver": {"type": "string"},
    "git_commit": {"type": "string"},
    "machine": {"type": "object"},
    "precision": {"enum": ["float32", "float64"]},
    "resolution": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"type": "integer", "minimum": 4}
    },
    "seed": {"type": "integer"},
    "initialization_seconds": {"type": "number", "minimum": 0},
    "cold_step_seconds": {"type": "number", "minimum": 0},
    "step_seconds": {"type": "array", "items": {"type": "number", "minimum": 0}},
    "median_step_seconds": {"type": "number", "minimum": 0},
    "p95_step_seconds": {"type": "number", "minimum": 0},
    "simulated_seconds_per_wall_second": {"type": "number", "minimum": 0},
    "cell_updates_per_second": {"type": "number", "minimum": 0},
    "particle_updates_per_second": {"type": "number", "minimum": 0},
    "peak_rss_bytes": {
      "anyOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "bounds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [{"type": "number"}, {"type": "number"}],
        "items": false
      }
    },
    "periodic_axes": {"type": "array", "uniqueItems": true, "items": {"enum": ["x", "y", "z"]}},
    "reynolds": {"type": "number", "exclusiveMinimum": 0},
    "freestream": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number"}},
    "foil": {
      "type": "object",
      "additionalProperties": false,
      "required": ["naca", "chord", "pivot"],
      "properties": {
        "naca": {"type": "string", "pattern": "^[0-9]{4}$"},
        "chord": {"type": "number", "exclusiveMinimum": 0},
        "pivot": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number"}}
      }
    },
    "control_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time", "angle_degrees"],
        "properties": {"time": {"type": "number", "minimum": 0}, "angle_degrees": {"type": "number"}}
      }
    },
    "requested_duration": {"type": "number", "exclusiveMinimum": 0},
    "simulated_duration": {"type": "number", "minimum": 0},
    "output_dt": {"type": "number", "exclusiveMinimum": 0},
    "memory_measurement": {
      "enum": ["rss", "browser-estimate", "unavailable"]
    },
    "runtime_startup_seconds": {
      "anyOf": [
        {"type": "number", "minimum": 0},
        {"type": "null"}
      ]
    },
    "worker_startup_seconds": {
      "anyOf": [
        {"type": "number", "minimum": 0},
        {"type": "null"}
      ]
    },
    "substeps": {"type": "integer", "minimum": 0},
    "final_state_revision": {"type": "integer", "minimum": 0},
    "diagnostic_state_revision": {
      "anyOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "last_step": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested_dt",
            "advanced_dt",
            "substeps",
            "max_speed",
            "state_revision",
            "evidence",
            "warnings"
          ],
          "properties": {
            "requested_dt": {"type": "number", "exclusiveMinimum": 0},
            "advanced_dt": {"type": "number", "exclusiveMinimum": 0},
            "substeps": {"type": "integer", "minimum": 1},
            "max_speed": {"type": "number", "minimum": 0},
            "state_revision": {"type": "integer", "minimum": 0},
            "evidence": {"$ref": "#/$defs/evidence"},
            "warnings": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "success": {"type": "boolean"},
    "failure": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason", "stage", "message", "evidence"],
          "properties": {
            "kind": {"enum": ["numerical", "unexpected"]},
            "reason": {
              "anyOf": [
                {"$ref": "#/$defs/failureReason"},
                {"type": "null"}
              ]
            },
            "stage": {
              "anyOf": [
                {"type": "string", "minLength": 1},
                {"type": "null"}
              ]
            },
            "message": {"type": "string", "minLength": 1},
            "evidence": {"$ref": "#/$defs/evidence"}
          }
        }
      ]
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "failureReason": {
      "enum": [
        "excessive_velocity",
        "stability_limit",
        "nonfinite_state",
        "convergence_failure",
        "projection_failure",
        "invalid_density",
        "invalid_population",
        "invalid_relaxation",
        "transfer_failure",
        "postcondition_failure",
        "time_contract_failure",
        "incompatible_geometry",
        "incompatible_domain",
        "unsupported_conversion"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {"type": "number"},
          {"type": "boolean"},
          {"type": "string"},
          {"type": "null"}
        ]
      }
    }
  }
}
