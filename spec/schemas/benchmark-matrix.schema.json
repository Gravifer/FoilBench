{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foilbench.local/spec/benchmark-matrix.schema.json",
  "title": "FoilBench benchmark matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "scenario", "solvers", "resolutions",
    "duration", "repetitions", "save_snapshots"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "solvers": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["stable-fluids", "lbm-d2q9", "pic-flip"]}
    },
    "resolutions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {"type": "integer", "minimum": 4},
          {"type": "integer", "minimum": 4}
        ],
        "items": false
      }
    },
    "duration": {"type": "number", "exclusiveMinimum": 0},
    "repetitions": {"type": "integer", "minimum": 1},
    "save_snapshots": {"type": "boolean"}
  }
}
