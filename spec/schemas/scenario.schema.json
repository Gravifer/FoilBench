{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foilbench.local/spec/scenario.schema.json",
  "title": "FoilBench scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "dimension",
    "bounds",
    "resolution",
    "periodic_axes",
    "reynolds",
    "freestream",
    "foil",
    "controls",
    "duration",
    "output_dt",
    "precision",
    "seed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "dimension": {"enum": [2, 3]},
    "bounds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [{"type": "number"}, {"type": "number"}],
        "items": false
      }
    },
    "resolution": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"type": "integer", "minimum": 4}
    },
    "periodic_axes": {
      "type": "array",
      "items": {"enum": ["x", "y", "z"]},
      "uniqueItems": true
    },
    "reynolds": {"type": "number", "exclusiveMinimum": 0},
    "freestream": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "foil": {
      "type": "object",
      "additionalProperties": false,
      "required": ["naca", "chord", "pivot"],
      "properties": {
        "naca": {"type": "string", "pattern": "^[0-9]{4}$"},
        "chord": {"type": "number", "exclusiveMinimum": 0},
        "pivot": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {"type": "number"}
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time", "angle_degrees"],
        "properties": {
          "time": {"type": "number", "minimum": 0},
          "angle_degrees": {"type": "number", "minimum": -90, "maximum": 90}
        }
      }
    },
    "duration": {"type": "number", "exclusiveMinimum": 0},
    "output_dt": {"type": "number", "exclusiveMinimum": 0},
    "precision": {"enum": ["float32", "float64"]},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "solver_options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initial_condition": {"enum": ["freestream", "taylor-green", "poiseuille"]},
        "stable_advection": {"enum": ["maccormack", "semi-lagrangian", "skew-rk2"]},
        "stable_face_advection": {"type": "boolean", "default": false},
        "stable_cfl": {"type": "number", "exclusiveMinimum": 0, "default": 0.7},
        "pressure_tolerance": {"type": "number", "exclusiveMinimum": 0, "default": 0.00001},
        "pressure_max_iterations": {"type": "integer", "minimum": 1, "default": 640},
        "mac_maximum_divergence_linf": {"type": "number", "minimum": 0},
        "mac_maximum_solid_leakage": {"type": "number", "minimum": 0},
        "pic_flip_blend": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.95},
        "pic_population_interval": {"type": "integer", "minimum": 1, "default": 8},
        "pic_cfl": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.75},
        "viewer_crop_cells": {"type": "integer", "minimum": 0, "default": 0},
        "viewer_crop_default": {"type": "boolean", "default": false}
      },
      "default": {}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"dimension": {"const": 2}}},
      "then": {
        "properties": {
          "bounds": {"type": "array", "minItems": 2, "maxItems": 2},
          "resolution": {"type": "array", "minItems": 2, "maxItems": 2},
          "freestream": {"type": "array", "minItems": 2, "maxItems": 2},
          "periodic_axes": {"type": "array", "items": {"enum": ["x", "y"]}},
          "foil": {"type": "object", "properties": {"pivot": {"type": "array", "minItems": 2, "maxItems": 2}}}
        }
      },
      "else": {
        "properties": {
          "bounds": {"type": "array", "minItems": 3, "maxItems": 3},
          "resolution": {"type": "array", "minItems": 3, "maxItems": 3},
          "freestream": {"type": "array", "minItems": 3, "maxItems": 3},
          "foil": {"type": "object", "properties": {"pivot": {"type": "array", "minItems": 3, "maxItems": 3}}}
        }
      }
    }
  ]
}
