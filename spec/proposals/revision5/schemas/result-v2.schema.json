{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foilbench.local/spec/proposals/revision5/result-v2.schema.json",
  "title": "FoilBench Revision 5 benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "contract_revision", "benchmark_matrix_id", "scenario_id", "repetition", "language", "implementation", "execution_target", "solver", "git_commit", "machine", "precision", "resolution", "bounds", "periodic_axes", "reynolds", "effective_reynolds", "solver_configuration", "freestream", "foil", "control_history", "requested_duration", "simulated_duration", "output_dt", "seed", "initialization_seconds", "cold_step_seconds", "step_seconds", "median_step_seconds", "p95_step_seconds", "simulated_seconds_per_wall_second", "cell_updates_per_second", "particle_updates_per_second", "peak_rss_bytes", "memory_measurement", "runtime_startup_seconds", "worker_startup_seconds", "substeps", "final_state_revision", "diagnostic_state_revision", "last_step", "diagnostics", "success", "failure", "warnings"],
  "properties": {
    "schema_version": {"const": 2},
    "contract_id": {"const": "foilbench-phase3-v1"},
    "contract_revision": {"const": 5},
    "benchmark_matrix_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string"},
    "repetition": {"type": "integer", "minimum": 1},
    "language": {"enum": ["python", "julia", "typescript", "rust"]},
    "implementation": {"enum": ["python", "julia", "typescript", "rust"]},
    "execution_target": {"enum": ["native", "node", "browser-worker", "wasm-browser"]},
    "solver": {"enum": ["stable-fluids", "lbm-d2q9", "pic-flip"]},
    "git_commit": {"type": "string", "minLength": 1},
    "machine": {"type": "object"},
    "precision": {"enum": ["float32", "float64"]},
    "resolution": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "integer", "minimum": 4}},
    "bounds": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false}},
    "periodic_axes": {"type": "array", "uniqueItems": true, "items": {"enum": ["x", "y", "z"]}},
    "reynolds": {"type": "number", "exclusiveMinimum": 0},
    "effective_reynolds": {"type": "number", "exclusiveMinimum": 0},
    "solver_configuration": {"type": "object"},
    "freestream": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number"}},
    "foil": {"type": "object", "required": ["naca", "chord", "pivot"]},
    "control_history": {"type": "array", "minItems": 1},
    "requested_duration": {"type": "number", "exclusiveMinimum": 0},
    "simulated_duration": {"type": "number", "minimum": 0},
    "output_dt": {"type": "number", "exclusiveMinimum": 0},
    "seed": {"type": "integer"},
    "initialization_seconds": {"type": "number", "minimum": 0},
    "cold_step_seconds": {"type": "number", "minimum": 0},
    "step_seconds": {"type": "array", "items": {"type": "number", "minimum": 0}},
    "median_step_seconds": {"type": "number", "minimum": 0},
    "p95_step_seconds": {"type": "number", "minimum": 0},
    "simulated_seconds_per_wall_second": {"type": "number", "minimum": 0},
    "cell_updates_per_second": {"type": "number", "minimum": 0},
    "particle_updates_per_second": {"type": "number", "minimum": 0},
    "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
    "memory_measurement": {"enum": ["rss", "browser-estimate", "unavailable"]},
    "runtime_startup_seconds": {"type": ["number", "null"], "minimum": 0},
    "worker_startup_seconds": {"type": ["number", "null"], "minimum": 0},
    "substeps": {"type": "integer", "minimum": 0},
    "final_state_revision": {"type": "integer", "minimum": 0},
    "diagnostic_state_revision": {"type": ["integer", "null"], "minimum": 0},
    "last_step": {"type": ["object", "null"]},
    "diagnostics": {"type": "object", "additionalProperties": {"type": "number"}},
    "success": {"type": "boolean"},
    "failure": {"type": ["object", "null"]},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"success": {"const": true}}}, "then": {"properties": {"failure": {"type": "null"}, "last_step": {"type": "object"}, "diagnostic_state_revision": {"type": "integer"}, "step_seconds": {"minItems": 1}}}},
    {"if": {"properties": {"memory_measurement": {"const": "unavailable"}}}, "then": {"properties": {"peak_rss_bytes": {"type": "null"}}}, "else": {"properties": {"peak_rss_bytes": {"type": "integer"}}}}
  ]
}
