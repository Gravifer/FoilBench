{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foilbench.local/spec/proposals/revision5/fullsize-acceptance-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "contract_revision", "startup", "scheduled_checkpoints", "warm_switch", "preview", "artifact_interchange", "chaotic_extension", "wasm_browser"],
  "properties": {
    "schema_version": {"const": 2},
    "contract_id": {"const": "foilbench-phase3-v1"},
    "contract_revision": {"const": 5},
    "startup": {"$ref": "#/$defs/solverGate"},
    "scheduled_checkpoints": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario", "solver", "resolution", "times", "required_producers"],
      "properties": {
        "scenario": {"type": "string", "minLength": 1}, "solver": {"$ref": "#/$defs/solver"},
        "resolution": {"$ref": "#/$defs/resolution"},
        "times": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
        "required_producers": {"const": ["python/native", "julia/native", "typescript/node", "rust/native"]}
      }
    },
    "warm_switch": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario", "resolution", "angles_degrees", "require_all_directed_pairs", "validate_fresh_fallback_first_step", "required_producers"],
      "properties": {
        "scenario": {"type": "string", "minLength": 1}, "resolution": {"$ref": "#/$defs/resolution"},
        "angles_degrees": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": -30, "maximum": 30}},
        "require_all_directed_pairs": {"const": true}, "validate_fresh_fallback_first_step": {"const": true},
        "required_producers": {"const": ["python/native", "julia/native", "typescript/node", "rust/native"]}
      }
    },
    "preview": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario", "resolution", "solvers", "required_producers", "minimum_development_machine_steps_per_second", "hosted_ci_records_only"],
      "properties": {
        "scenario": {"type": "string", "minLength": 1}, "resolution": {"$ref": "#/$defs/resolution"},
        "solvers": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/solver"}},
        "required_producers": {"const": ["python/native", "julia/native", "typescript/browser-worker", "rust/native", "rust/wasm-browser"]},
        "minimum_development_machine_steps_per_second": {"type": "number", "exclusiveMinimum": 0},
        "hosted_ci_records_only": {"const": true}
      }
    },
    "artifact_interchange": {
      "type": "object", "additionalProperties": false,
      "required": ["matrix", "required_producers", "require_every_comparer"],
      "properties": {
        "matrix": {"type": "string", "minLength": 1},
        "required_producers": {"const": ["python/native", "julia/native", "typescript/node", "rust/native"]},
        "require_every_comparer": {"const": true}
      }
    },
    "chaotic_extension": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture", "required_producers", "preflight_before_long_run", "minimum_probe_rms", "minimum_spectral_entropy", "minimum_broadband_power_fraction", "minimum_enstrophy_coefficient_of_variation", "maximum_dominant_power_fraction", "minimum_sensitivity_amplification"],
      "properties": {
        "fixture": {"type": "string", "minLength": 1},
        "required_producers": {"const": ["python/native", "julia/native", "typescript/node", "rust/native"]},
        "preflight_before_long_run": {"const": true},
        "minimum_probe_rms": {"type": "number", "minimum": 0}, "minimum_spectral_entropy": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_broadband_power_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_enstrophy_coefficient_of_variation": {"type": "number", "minimum": 0},
        "maximum_dominant_power_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_sensitivity_amplification": {"type": "number", "exclusiveMinimum": 1}
      }
    },
    "wasm_browser": {
      "type": "object", "additionalProperties": false,
      "required": ["producer", "gates"],
      "properties": {
        "producer": {"const": "rust/wasm-browser"},
        "gates": {"const": ["protocol", "scheduled-control", "deterministic-state", "recovery", "canonical", "warm-switch", "sensitivity-preflight", "preview", "production-browser"]}
      }
    }
  },
  "$defs": {
    "solver": {"enum": ["stable-fluids", "lbm-d2q9", "pic-flip"]},
    "resolution": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 4}, {"type": "integer", "minimum": 4}], "items": false},
    "solverGate": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario", "resolution", "solvers", "required_producers"],
      "properties": {
        "scenario": {"type": "string", "minLength": 1}, "resolution": {"$ref": "#/$defs/resolution"},
        "steps": {"type": "integer", "minimum": 1},
        "solvers": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/solver"}},
        "required_producers": {"const": ["python/native", "julia/native", "typescript/node", "rust/native"]}
      }
    }
  }
}
